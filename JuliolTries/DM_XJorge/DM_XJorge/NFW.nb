Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pc", "=", 
    RowBox[{"3.0857", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", "16", ")"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"in", " ", "m"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kpc", "=", 
    RowBox[{
     RowBox[{"10", "^", "3"}], " ", "pc"}]}], ";"}], 
  RowBox[{"(*", "pc", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"d", "=", "50."}], ";"}], 
  RowBox[{"(*", "kpc", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Profile", "[", "r_", "]"}], ":=", 
  RowBox[{"NFW", "[", "r", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RGC\[Theta]", "[", 
   RowBox[{"s_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"s", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ";", 
     RowBox[{"y", "=", "0"}], ";", 
     RowBox[{"x", "=", 
      RowBox[{"d", "-", 
       RowBox[{"s", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}], "+", 
       RowBox[{"z", "^", "2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"step", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LosD\[Theta]", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Kpc", " ", 
     RowBox[{"10", "^", "2"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Profile", "[", 
        RowBox[{"RGC\[Theta]", "[", 
         RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0.", ",", 
         RowBox[{"d", "-", "step"}]}], "}"}]}], "]"}], "+", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Profile", "[", 
        RowBox[{"RGC\[Theta]", "[", 
         RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{"d", "-", "step"}], ",", 
         RowBox[{"d", "+", "step"}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<SymbolicProcessing\>\"", " ", "->", " ", "0"}]}], 
         "}"}]}]}], "]"}], "+", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Profile", "[", 
        RowBox[{"RGC\[Theta]", "[", 
         RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{"d", "+", "step"}], ",", 
         RowBox[{"1.5", "d"}]}], "}"}]}], "]"}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.954393926734646*^9, 3.954394008098171*^9}, {
  3.9543940412258587`*^9, 3.954394051563348*^9}, {3.9543941201214046`*^9, 
