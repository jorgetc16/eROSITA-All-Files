Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SolarMass", "=", 
    RowBox[{"1.988", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", "30", ")"}]}]}]}], ";"}], 
  RowBox[{"(*", "Kg", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eVtoKg", "=", 
    RowBox[{"1.782662", "\[Times]", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "36"}], ")"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", "Kg", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pc", "=", 
    RowBox[{"3.0857", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", "16", ")"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"in", " ", "m"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rs", "=", "9.8"}], ";"}], 
  RowBox[{"(*", "kpc", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]s", "=", 
   RowBox[{"5.1", " ", 
    RowBox[{"10", "^", "6"}], "  ", "SolarMass", " ", 
    RowBox[{"1", "/", "eVtoKg"}], " ", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "9"}], ")"}]}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"10", "^", "3"}], " ", "pc", " ", 
       RowBox[{"10", "^", "2"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"GeV", " ", "cm"}], "-", "3"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NFW", "[", "r_", "]"}], ":=", 
   RowBox[{"\[Rho]s", " ", 
    RowBox[{"rs", "/", "r"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"r", "/", "rs"}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"-", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NFW", "[", "50", "]"}]}], "Input",
