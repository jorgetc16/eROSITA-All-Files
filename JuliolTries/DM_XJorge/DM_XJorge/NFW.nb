Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{
   "From", " ", "SPHEREX", " ", "notebook", " ", "as", " ", "a", " ", 
    "check"}], "*)"}], "\[IndentingNewLine]", 
