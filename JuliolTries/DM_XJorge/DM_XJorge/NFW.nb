Cell[BoxData[{
 RowBox[{
  RowBox[{"Npoints", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]min", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]max", "=", "20."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log10", "[", "\[Theta]min", "]"}], "+", 
         RowBox[{
          RowBox[{"Log10", "[", 
           RowBox[{"\[Theta]max", "/", "\[Theta]min"}], "]"}], "*", 
          RowBox[{"i", "/", "Npoints"}]}]}], ")"}]}], " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";", 
    RowBox[{"(*", "rad", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aIntelos\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{"LosD\[Theta]", "[", 
      RowBox[{"a\[Theta]", "[", "i", "]"}], "]"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log10", "@", 
         RowBox[{"a\[Theta]", "[", "i", "]"}]}], ",", 
        RowBox[{"Log10", "@", 
         RowBox[{"aIntelos\[Theta]", "[", "i", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], "]"}], ",", 
    RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
     RowBox[{"Log10", "[", "x", "]"}], "]"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10.", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
