Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"NFW", " ", "from", " ", "Cirelli"}], "-", "Strumia", "-", 
    "Zupan"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rs", "=", "14.46"}], ";"}], 
   RowBox[{"(*", "kpc", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]s", "=", "0.566"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"GeV", " ", "cm"}], "-", "3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rsun", "=", "8.33"}], ";"}], 
   RowBox[{"(*", "kpc", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NFW", "[", "r_", "]"}], ":=", 
    RowBox[{"\[Rho]s", " ", 
     RowBox[{"rs", "/", "r"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"r", "/", "rs"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"-", "2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Profile", "[", "r_", "]"}], ":=", 
    RowBox[{"NFW", "[", "r", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RGC", "[", 
     RowBox[{"s_", ",", "l_", ",", "b_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"z", "=", 
        RowBox[{"s", " ", 
         RowBox[{"Sin", "[", "b", "]"}]}]}], ";", 
       RowBox[{"y", "=", 
        RowBox[{"s", " ", 
         RowBox[{"Cos", "[", "b", "]"}], 
         RowBox[{"Sin", "[", "l", "]"}]}]}], ";", 
       RowBox[{"x", "=", 
        RowBox[{"Rsun", "-", 
         RowBox[{"s", " ", 
          RowBox[{"Cos", "[", "b", "]"}], 
          RowBox[{"Cos", "[", "l", "]"}]}]}]}], ";", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}], "+", 
         RowBox[{"z", "^", "2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RGC\[Theta]", "[", 
     RowBox[{"s_", ",", "\[Theta]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"z", "=", 
        RowBox[{"s", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ";", 
       RowBox[{"y", "=", "0"}], ";", 
       RowBox[{"x", "=", 
        RowBox[{"Rsun", "-", 
         RowBox[{"s", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}], "+", 
         RowBox[{"z", "^", "2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pc", "=", 
     RowBox[{"3.0857", " ", 
      RowBox[{"10", "^", 
       RowBox[{"(", "16", ")"}]}]}]}], " ", ";"}], 
   RowBox[{"(*", 
    RowBox[{"in", " ", "m"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Kpc", "=", 
     RowBox[{
      RowBox[{"10", "^", "3"}], " ", "pc"}]}], ";"}], 
   RowBox[{"(*", "pc", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"step", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Output", " ", "in", " ", "GeV", " ", "cm"}], "-", "2"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LosD", "[", 
     RowBox[{"l_", ",", "b_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Kpc", " ", 
       RowBox[{"10", "^", "2"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC", "[", 
           RowBox[{"s", ",", "l", ",", "b"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0.", ",", 
           RowBox[{"Rsun", "-", "step"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC", "[", 
           RowBox[{"s", ",", "l", ",", "b"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"Rsun", "-", "step"}], ",", 
           RowBox[{"Rsun", "+", "step"}]}], "}"}], ",", 
         RowBox[{"Method", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", 
            RowBox[{"\"\<SymbolicProcessing\>\"", " ", "->", " ", "0"}]}], 
           "}"}]}]}], "]"}], "+", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC", "[", 
           RowBox[{"s", ",", "l", ",", "b"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "Rsun", ",", 
           RowBox[{"1.5", "Rsun"}]}], "}"}]}], "]"}]}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LosD\[Theta]", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Kpc", " ", 
       RowBox[{"10", "^", "2"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC\[Theta]", "[", 
           RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0.", ",", 
           RowBox[{"Rsun", "-", "0.1"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC\[Theta]", "[", 
           RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"Rsun", "-", "0.1"}], ",", " ", 
           RowBox[{"Rsun", "+", "0.1"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"Profile", "[", 
          RowBox[{"RGC\[Theta]", "[", 
           RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"Rsun", "+", "0.1"}], ",", 
           RowBox[{"10", " ", "Rsun"}]}], "}"}]}], "]"}]}], 
      ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.954396989442321*^9, 3.954396990284697*^9}, {
