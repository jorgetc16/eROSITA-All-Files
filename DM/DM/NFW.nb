    RowBox[{
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Profile", "[", 
        RowBox[{"RGC\[Theta]", "[", 
         RowBox[{"s", ",", "\[Theta]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0.", ",", 
         RowBox[{"d", "-", "step"}]}], "}"}]}], "]"}], "+", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Profile", "[", 
