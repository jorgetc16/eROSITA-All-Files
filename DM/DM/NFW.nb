      RowBox[{"(", "16", ")"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"in", " ", "m"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kpc", "=", 
    RowBox[{
     RowBox[{"10", "^", "3"}], " ", "pc"}]}], ";"}], 
  RowBox[{"(*", "pc", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"d", "=", "50."}], ";"}], 
  RowBox[{"(*", "kpc", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Profile", "[", "r_", "]"}], ":=", 
  RowBox[{"NFW", "[", "r", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RGC\[Theta]", "[", 
   RowBox[{"s_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"s", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ";", 
     RowBox[{"y", "=", "0"}], ";", 
     RowBox[{"x", "=", 
      RowBox[{"d", "-", 
       RowBox[{"s", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}], "+", 
       RowBox[{"z", "^", "2"}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"step", "=", "1."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LosD\[Theta]", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{
