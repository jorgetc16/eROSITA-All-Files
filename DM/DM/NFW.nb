Cell["\<\
Finally compute dD/d\[CapitalOmega]. Just for reference, in the Spherex paper \
for the north patch I had (see TestSpherex.nb):
dDd\[CapitalOmega]MWNP = 4.34977  10^20/(100 (Pi/180)^2)(*GeV cm-2 sr-1*) \
=1.4e22\
\>", "Text",
 CellChangeTimes->{{3.967896963145746*^9, 3.967897019457451*^9}, {
  3.967897200210917*^9, 3.96789720544316*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"575cd471-9401-4e14-afea-6feb778f0555"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Coordinates", " ", "LMC", " ", "here", " ", 
      RowBox[{"https", ":"}]}], "//", 
     RowBox[{
      RowBox[{"simbad", ".", "u"}], "-", 
      RowBox[{
       RowBox[{
        RowBox[{"strasbg", ".", "fr"}], "/", "simbad"}], "/", "sim"}], "-", 
      RowBox[{"id", "?", "Ident"}]}]}], "=", 
    RowBox[{"Large", "+", "Magellanic", "+", "Cloud"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lLMC", "=", 
     RowBox[{"280.4652", " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bLMC", "=", 
     RowBox[{
      RowBox[{"-", "32.8884"}], " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "ones", " ", "before", " ", "of", " ", "dynamical", " ", 
      "center"}], ",", " ", 
     RowBox[{"small", " ", "difference"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lLMC", "=", 
     RowBox[{"279.88437784", "  ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bLMC", "=", 
     RowBox[{
      RowBox[{"-", "33.23695025"}], " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Alpha]int", "=", "3.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]\[CapitalOmega]", "=", 
     RowBox[{"2", "Pi", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Alpha]int", " ", 
          RowBox[{"Pi", "/", "180."}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\[CapitalDelta]\[CapitalOmega] in deg2 \>\"", ",", 
     RowBox[{"\[CapitalDelta]\[CapitalOmega]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"180", "/", "Pi"}], ")"}], "^", "2"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<dD/d\[CapitalOmega] GeV cm-2 sr-1 \>\"", ",", 
     RowBox[{"LosD", "[", 
      RowBox[{"lLMC", ",", "bLMC"}], "]"}], ",", "\"\< \>\"", ",", 
     RowBox[{"LosD\[Theta]", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"lLMC", "^", "2"}], "+", 
        RowBox[{"bLMC", "^", "2"}]}], "]"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dfact", "=", 
     RowBox[{
      RowBox[{"LosD\[Theta]", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"lLMC", "^", "2"}], "+", 
         RowBox[{"bLMC", "^", "2"}]}], "]"}], "]"}], " ", 
      "\[CapitalDelta]\[CapitalOmega]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<D GeV cm-2 \>\"", ",", "Dfact", ",", "\"\< for \[Alpha] [deg] \>\"", 
     ",", "\[Alpha]int"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dfact", "=", 
     RowBox[{
      RowBox[{"LosD", "[", 
       RowBox[{"lLMC", ",", "bLMC"}], "]"}], " ", 
      "\[CapitalDelta]\[CapitalOmega]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<D GeV cm-2 \>\"", ",", "Dfact", ",", "\"\< for \[Alpha] [deg] \>\"", 
     ",", "\[Alpha]int"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.95439775773816*^9, 3.954397784142417*^9}, {
