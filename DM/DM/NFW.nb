Cell["D-factor MW from GC", "Text",
 CellChangeTimes->{{3.954393867753841*^9, 3.954393886047127*^9}, {
  3.954396975276004*^9, 3.9543969757159357`*^9}, {3.967896226635684*^9, 
  3.967896232287675*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"6134fcfc-b190-4012-8108-75c8b6bb43cf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Npoints", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]min", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]max", "=", "20."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log10", "[", "\[Theta]min", "]"}], "+", 
         RowBox[{
          RowBox[{"Log10", "[", 
           RowBox[{"\[Theta]max", "/", "\[Theta]min"}], "]"}], "*", 
          RowBox[{"i", "/", "Npoints"}]}]}], ")"}]}], " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";", 
    RowBox[{"(*", "rad", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aIntelos\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{"LosD\[Theta]", "[", 
      RowBox[{"a\[Theta]", "[", "i", "]"}], "]"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log10", "@", 
         RowBox[{"a\[Theta]", "[", "i", "]"}]}], ",", 
        RowBox[{"Log10", "@", 
         RowBox[{"aIntelos\[Theta]", "[", "i", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], "]"}], ",", 
    RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
     RowBox[{"Log10", "[", "x", "]"}], "]"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10.", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
     RowBox[{"Log10", "[", "x", "]"}], "]"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dDd\[CapitalOmega]", "[", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"Pi", "/", "180"}]}], "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Theta]min", " ", ",", "\[Theta]max"}], "}"}], 
   ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Darker", "[", "Green", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dotted"}], "}"}]}], "}"}]}]}], 
  RowBox[{"(*", 
   RowBox[{",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"StyleFrameLabel", "[", "\"\<\[Theta] [rad]\>\"", "]"}], ",", 
       RowBox[{
       "StyleFrameLabel", "[", 
        "\"\<dD/d\[CapitalOmega](\[Alpha]) [GeV \!\(\*SuperscriptBox[\(cm\), \
\(-2\)]\)\!\(\*SuperscriptBox[\(sr\), \(-1\)]\)]\>\"", "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameStyle", "\[Rule]", " ", "StyleFrameTicks"}]}], "*)"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9610367903176622`*^9, 3.9610368346467733`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"643029bc-cea7-47c1-ade2-8621c6258ad2"],

