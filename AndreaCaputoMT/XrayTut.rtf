\fs64 How to make Plot\
\pard\pardeftab720\partightenfactor0

\fs24 \cf2 data "/Users/andreacaputo/Dropbox/Mac (2)/Desktop/PhysicsFolder/eRositaXray/Spectra_irfs/LMC_TM1_pha.fits"
\fs64 \

\fs24 ignore 0-72, 926-1023\
Fit\
cpd /xw (cpd / XS)\
plot ldata delchi\
\
\
XSPEC> iplot data \
PLT> r x 0.5 10 \
PLT> r y 1e-3 1e2 \
PLT> hardcopy plot.ps/cps \
PLT> exit\
\
\pard\pardeftab720\partightenfactor0

