Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Npoints", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]min", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]max", "=", "20."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log10", "[", "\[Theta]min", "]"}], "+", 
         RowBox[{
          RowBox[{"Log10", "[", 
           RowBox[{"\[Theta]max", "/", "\[Theta]min"}], "]"}], "*", 
          RowBox[{"i", "/", "Npoints"}]}]}], ")"}]}], " ", 
      RowBox[{"Pi", "/", "180"}]}]}], ";", 
    RowBox[{"(*", "rad", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"aIntelos\[Theta]", "[", "i", "]"}], "=", 
     RowBox[{"LosD\[Theta]", "[", 
      RowBox[{"a\[Theta]", "[", "i", "]"}], "]"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log10", "@", 
         RowBox[{"a\[Theta]", "[", "i", "]"}]}], ",", 
        RowBox[{"Log10", "@", 
         RowBox[{"aIntelos\[Theta]", "[", "i", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "Npoints"}], "}"}]}], "]"}], ",", 
    RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
     RowBox[{"Log10", "[", "x", "]"}], "]"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"10.", "^", 
   RowBox[{"(", 
    RowBox[{"dDd\[CapitalOmega]\[Theta]LogLog", "[", 
     RowBox[{"Log10", "[", "x", "]"}], "]"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dDd\[CapitalOmega]", "[", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"Pi", "/", "180"}]}], "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "\[Theta]min", " ", ",", "\[Theta]max"}], "}"}], 
   ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Darker", "[", "Green", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dotted"}], "}"}]}], "}"}]}]}], 
  RowBox[{"(*", 
   RowBox[{",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"StyleFrameLabel", "[", "\"\<\[Theta] [rad]\>\"", "]"}], ",", 
       RowBox[{
       "StyleFrameLabel", "[", 
        "\"\<dD/d\[CapitalOmega](\[Alpha]) [GeV \!\(\*SuperscriptBox[\(cm\), \
\(-2\)]\)\!\(\*SuperscriptBox[\(sr\), \(-1\)]\)]\>\"", "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameStyle", "\[Rule]", " ", "StyleFrameTicks"}]}], "*)"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
